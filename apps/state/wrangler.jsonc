{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Durable state for a self-hosted EventForge control plane (EVENTFORGE_STORE=cloudflare).
  // One SQLite-backed Durable Object per workspace, plus one registry object that lists them.
  "name": "eventforge-state",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "state.eventforge.dev", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "limits": { "cpu_ms": 1000 },
  "secrets": { "required": ["STATE_API_TOKEN"] },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE_STATE", "class_name": "WorkspaceState" },
      { "name": "STATE_REGISTRY", "class_name": "StateRegistry" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceState", "StateRegistry"] }],
}
