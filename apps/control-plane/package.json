{
  "name": "@eventforge/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:github": "EVENTFORGE_GITHUB_LOCAL_WEBHOOK=true EVENTFORGE_RUNNER=codex tsx src/index.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "migrate:status": "tsx src/migrate-cli.ts --status",
    "migrate:list": "tsx src/migrate-cli.ts --list"
  },
  "dependencies": {
    "@eventforge/core": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@openai/codex-sdk": "^0.144.5",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "fastify-raw-body": "^5.0.0",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^11.2.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/pg": "^8.15.4",
    "tsx": "^4.23.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.126.0"
  }
}
